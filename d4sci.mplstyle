# Data For Science style
# Author: Bruno Goncalves <bgoncalves@data4sci.com>
# Modified from the matplotlib FiveThirtyEight style by
# Author: Cameron Davidson-Pilon, replicated styles from FiveThirtyEight.com
# See https://www.dataorigami.net/blogs/fivethirtyeight-mpl
# Revised toward Tufte: open frame, faint grid, frameless legends. The
# branded color cycle, thick lines, and large type stay.

lines.linewidth: 4
lines.solid_capstyle: butt

legend.frameon: false

axes.prop_cycle: cycler('color', ['51a7f9', 'cf51f9', '70bf41', 'f39019', 'f9e351', 'f9517b', '6d904f', '8b8b8b','810f7c']) 

axes.labelsize: large
axes.axisbelow: true
axes.grid: true
axes.edgecolor: ffffff
axes.linewidth: 1.5
axes.spines.top: False
axes.spines.right: False
axes.titlesize: x-large

patch.edgecolor: ffffff
patch.linewidth: 0.5

svg.fonttype: path

grid.linestyle: -
grid.linewidth: 0.75
grid.alpha: 0.5

xtick.major.size: 0
xtick.minor.size: 0
ytick.major.size: 0
ytick.minor.size: 0

font.size: 24.0

savefig.edgecolor: ffffff
savefig.facecolor: ffffff

figure.subplot.left: 0.08
figure.subplot.right: 0.95
figure.subplot.bottom: 0.07
figure.figsize: 12.8, 8.8
figure.autolayout: True
figure.dpi: 300
